{
  "name": "MD Reader Pro - Trình đọc Markdown",
  "short_name": "MD Reader",
  "description": "Đọc, chỉnh sửa và xuất Markdown đẹp với đầy đủ tính năng: tabs, edit mode, Mermaid, KaTeX, TTS tiếng Việt",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#c17f3a",
  "background_color": "#f7f6f3",
  "lang": "vi",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Tab mới",
      "short_name": "Mới",
      "description": "Tạo file Markdown mới",
      "url": "./index.html?action=new"
    },
    {
      "name": "Mở file",
      "short_name": "Mở",
      "description": "Mở file Markdown",
      "url": "./index.html?action=open"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ]
}
